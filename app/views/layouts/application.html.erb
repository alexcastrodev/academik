<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Academik" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", data_turbo_track: "reload" %>
    <%= yield :head %>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" nonce="<%= request.content_security_policy_nonce %>"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-gray-100 font-sans text-sm text-gray-800 antialiased" data-controller="mobile-nav">

    <%# ===== Mobile top bar ===== %>
    <header class="flex items-center gap-2 px-3 h-12 bg-white border-b border-gray-200 md:hidden sticky top-0 z-30">
      <button class="p-1.5 rounded-md text-gray-500 hover:bg-gray-100"
              data-action="click->mobile-nav#toggleSidebar" aria-label="Menu">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
      <%= link_to root_path, class: "flex items-center gap-1.5 font-semibold text-gray-800 text-base" do %>
        <i data-lucide="book-open" class="w-5 h-5 text-blue-600"></i>
        Academik
      <% end %>
      <div class="flex-1"></div>
      <%= link_to new_paper_path, class: "flex items-center gap-1 bg-blue-600 text-white text-xs font-medium px-3 py-1.5 rounded-md hover:bg-blue-700" do %>
        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add
      <% end %>
    </header>

    <div class="flex h-[calc(100vh-3rem)] md:h-screen overflow-hidden">

      <%# ===== Sidebar (off-canvas on mobile, always visible on md+) ===== %>
      <aside class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-white border-r border-gray-200 transform -translate-x-full transition-transform duration-200
                    md:relative md:translate-x-0 md:w-56 md:flex-shrink-0 md:top-0"
             data-mobile-nav-target="sidebar">
        <%# Sidebar header (desktop only) %>
        <div class="hidden md:flex items-center gap-2 px-4 h-12 border-b border-gray-200 flex-shrink-0">
          <%= link_to root_path, class: "flex items-center gap-2 font-semibold text-gray-800" do %>
            <i data-lucide="book-open" class="w-5 h-5 text-blue-600"></i>
            Academik
          <% end %>
          <div class="flex-1"></div>
          <%= link_to new_paper_path, class: "p-1.5 rounded-md text-blue-600 hover:bg-blue-50", title: "Add paper" do %>
            <i data-lucide="plus" class="w-4 h-4"></i>
          <% end %>
        </div>

        <%# Flash messages %>
        <% if notice %>
          <div class="mx-3 mt-2 px-3 py-2 bg-green-50 border border-green-200 text-green-800 text-xs rounded-md"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="mx-3 mt-2 px-3 py-2 bg-red-50 border border-red-200 text-red-800 text-xs rounded-md"><%= alert %></div>
        <% end %>

        <%# Search (mobile sidebar) %>
        <div class="px-3 py-2 md:hidden">
          <%= form_with url: papers_path, method: :get, data: { turbo_frame: "_top" } do |f| %>
            <div class="relative">
              <i data-lucide="search" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none"></i>
              <%= f.text_field :q, value: params[:q], placeholder: "Search…",
                  class: "w-full pl-8 pr-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
            </div>
          <% end %>
        </div>

        <nav class="flex-1 overflow-y-auto px-2 py-1 space-y-0.5">
          <%# Main library links %>
          <%= lib_link papers_path, "layers", "All References",
                active: controller_name == "papers" && params[:collection_id].blank? && params[:tag_id].blank? && params[:sort].blank? && params[:reading_status].blank? %>
          <%= lib_link papers_path(sort: "recent"), "clock", "Recently Added",
                active: params[:sort] == "recent" %>
          <%= lib_link papers_path(reading_status: "read"), "book-check", "Read",
                active: params[:reading_status] == "read" %>
          <%= lib_link papers_path(reading_status: "to_cite"), "quote", "To Cite",
                active: params[:reading_status] == "to_cite" %>

          <div class="pt-3 pb-1 px-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Collections</div>
          <% Collection.roots.includes(:children).each do |col| %>
            <%= lib_link papers_path(collection_id: col.id), "folder", col.name,
                  active: params[:collection_id] == col.id.to_s,
                  count: col.papers.count %>
            <% col.children.each do |child| %>
              <%= lib_link papers_path(collection_id: child.id), "folder", child.name,
                    active: params[:collection_id] == child.id.to_s,
                    count: child.papers.count,
                    indent: true %>
            <% end %>
          <% end %>
          <%= link_to new_collection_path, class: "flex items-center gap-1.5 px-2 py-1 text-xs text-gray-400 hover:text-gray-600 rounded-md hover:bg-gray-50" do %>
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> New collection
          <% end %>

          <div class="pt-3 pb-1 px-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Tags</div>
          <% Tag.all.each do |tag| %>
            <%= link_to papers_path(tag_id: tag.id),
                  class: "flex items-center gap-2 px-2 py-1.5 rounded-md text-sm #{ params[:tag_id] == tag.id.to_s ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-700 hover:bg-gray-100' }",
                  data: { controller: "tag-dot", tag_color: tag.color } do %>
              <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 tag-dot-circle" style="background:<%= tag.color %>"></span>
              <span class="flex-1 truncate"><%= tag.name %></span>
              <span class="text-[10px] text-gray-400"><%= tag.papers.count %></span>
            <% end %>
          <% end %>
          <%= link_to new_tag_path, class: "flex items-center gap-1.5 px-2 py-1 text-xs text-gray-400 hover:text-gray-600 rounded-md hover:bg-gray-50" do %>
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> New tag
          <% end %>
        </nav>

        <%# Bottom nav links %>
        <div class="border-t border-gray-200 px-2 py-2 space-y-0.5 flex-shrink-0">
          <%= lib_link collections_path, "folder-open", "Manage Collections", active: controller_name == "collections" %>
          <%= lib_link tags_path, "tag", "Manage Tags", active: controller_name == "tags" %>
          <%= lib_link latex_documents_path, "file-text", "LaTeX Documents", active: controller_name == "latex_documents" %>
          <%= lib_link settings_path, "settings", "Settings", active: controller_name == "settings" %>
        </div>
      </aside>

      <%# Overlay for mobile sidebar %>
      <div class="fixed inset-0 z-30 bg-black/40 hidden md:hidden"
           data-mobile-nav-target="overlay"
           data-action="click->mobile-nav#closeSidebar"></div>

      <%# ===== Main content ===== %>
      <main class="flex-1 flex flex-col min-w-0 overflow-hidden">

        <%# Desktop search + add bar %>
        <div class="hidden md:flex items-center gap-3 px-4 h-12 bg-white border-b border-gray-200 flex-shrink-0">
          <%= form_with url: papers_path, method: :get, data: { turbo_frame: "_top" }, class: "flex-1 max-w-lg" do |f| %>
            <div class="relative">
              <i data-lucide="search" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none"></i>
              <%= f.text_field :q, value: params[:q], placeholder: "Search references…",
                  class: "w-full pl-8 pr-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
            </div>
          <% end %>
          <div class="flex-1"></div>
          <%= link_to new_paper_path, class: "flex items-center gap-1.5 bg-blue-600 text-white text-sm font-medium px-4 py-1.5 rounded-md hover:bg-blue-700 transition-colors" do %>
            <i data-lucide="plus" class="w-4 h-4"></i> Add references
          <% end %>
        </div>

        <%# Page content %>
        <div class="flex-1 overflow-hidden">
          <% if content_for?(:full_bleed) %>
            <%= yield :full_bleed %>
          <% else %>
            <div class="h-full overflow-y-auto p-4 md:p-6">
              <%= yield %>
            </div>
          <% end %>
        </div>

      </main>
    </div>

    <script nonce="<%= request.content_security_policy_nonce %>">lucide.createIcons();</script>
  </body>
</html>
