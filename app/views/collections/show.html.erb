<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <% if @collection.parent %>
      <p class="text-xs text-gray-400 mb-1">
        <%= link_to @collection.parent.name, @collection.parent, class: "hover:underline" %> /
      </p>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
      <i data-lucide="folder" class="w-5 h-5 text-amber-500"></i>
      <%= @collection.name %>
    </h1>
    <% if @collection.description.present? %>
      <p class="mt-1 text-sm text-gray-500"><%= @collection.description %></p>
    <% end %>
  </div>
  <div class="flex items-center gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_collection_path(@collection),
        class: "px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
    <%= button_to "Generate LaTeX", generate_latex_collection_path(@collection), method: :post,
        class: "px-3 py-1.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
  </div>
</div>

<% if @collection.children.any? %>
  <div class="bg-white border border-gray-200 rounded-xl p-4 mb-5">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Sub-collections</h2>
    <ul class="space-y-1">
      <% @collection.children.each do |child| %>
        <li>
          <%= link_to child, class: "flex items-center gap-2 text-sm text-blue-600 hover:underline" do %>
            <i data-lucide="folder" class="w-3.5 h-3.5 text-amber-400"></i>
            <%= child.name %>
            <span class="text-gray-400">(<%= child.papers.count %> papers)</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div>
  <h2 class="text-sm font-semibold text-gray-600 mb-3">Papers (<%= @papers.count %>)</h2>
  <% if @papers.empty? %>
    <div class="flex flex-col items-center justify-center h-32 text-gray-400 gap-2 bg-white border border-gray-200 rounded-xl">
      <i data-lucide="inbox" class="w-8 h-8 opacity-30"></i>
      <p class="text-sm">No papers in this collection yet.</p>
    </div>
  <% else %>
    <div class="space-y-2">
      <% @papers.each do |paper| %>
        <%= render "papers/paper", paper: paper %>
      <% end %>
    </div>
  <% end %>
</div>
