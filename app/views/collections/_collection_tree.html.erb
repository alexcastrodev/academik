<div class="border-b border-gray-100 last:border-0" style="padding-left: <%= depth * 1.5 %>rem">
  <div class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 group">
    <i data-lucide="folder" class="w-4 h-4 text-amber-500 flex-shrink-0"></i>
    <%= link_to collection.name, collection, class: "flex-1 text-sm font-medium text-gray-800 hover:text-blue-600 truncate" %>
    <span class="text-xs text-gray-400"><%= collection.papers.count %> papers</span>
    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= link_to "Edit", edit_collection_path(collection),
          class: "px-2 py-1 text-xs text-gray-600 hover:bg-gray-200 rounded transition-colors" %>
      <%= button_to "Delete", collection, method: :delete,
          data: { turbo_confirm: "Delete #{collection.name}?" },
          class: "px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded transition-colors cursor-pointer" %>
    </div>
  </div>
  <% if depth < 5 %>
    <% collection.children.each do |child| %>
      <%= render "collection_tree", collection: child, depth: depth + 1 %>
    <% end %>
  <% end %>
</div>
