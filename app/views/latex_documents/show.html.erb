<% content_for :title, @document.title %>

<div class="max-w-4xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to latex_documents_path, class: "p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg" do %>
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-800 flex-1 truncate"><%= @document.title %></h1>
    <%= link_to "Download .tex", download_latex_document_path(@document),
        class: "flex items-center gap-1.5 bg-blue-600 text-white text-sm font-medium px-4 py-1.5 rounded-lg hover:bg-blue-700 transition-colors" do %>
      <i data-lucide="download" class="w-4 h-4"></i> Download .tex
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-5">
    <%= form_with model: @document, url: latex_document_path(@document), method: :patch do |f| %>
      <div class="mb-4" data-controller="latex-editor">
        <%= f.text_area :content, class: "latex-textarea w-full",
            data: { "latex-editor-target": "source" } %>
      </div>
      <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
        <%= f.submit "Save", class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 cursor-pointer transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
