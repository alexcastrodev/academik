<div class="max-w-sm mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to tags_path, class: "p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg" do %>
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-800">New Tag</h1>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl p-5">
    <%= form_with model: @tag do |f| %>
      <div class="mb-4">
        <%= f.label :name, class: "block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1" %>
        <%= f.text_field :name, required: true,
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
      <div class="mb-6">
        <%= f.label :color, "Color", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1" %>
        <%= f.color_field :color, class: "h-10 w-16 p-1 border border-gray-300 rounded-lg cursor-pointer" %>
      </div>
      <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
        <%= f.submit "Create Tag", class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 cursor-pointer transition-colors" %>
        <%= link_to "Cancel", tags_path, class: "px-5 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 rounded-lg hover:bg-gray-100 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
