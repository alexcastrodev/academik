<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800">Tags</h1>
  <%= link_to new_tag_path, class: "flex items-center gap-1.5 bg-blue-600 text-white text-sm font-medium px-4 py-1.5 rounded-lg hover:bg-blue-700 transition-colors" do %>
    <i data-lucide="plus" class="w-4 h-4"></i> New Tag
  <% end %>
</div>

<% if @tags.empty? %>
  <div class="flex flex-col items-center justify-center h-48 text-gray-400 gap-2">
    <i data-lucide="tag" class="w-10 h-10 opacity-30"></i>
    <p class="text-sm">No tags yet.</p>
    <%= link_to "Create one", new_tag_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <% @tags.each do |tag| %>
      <div class="flex items-center gap-3 px-4 py-3 border-b border-gray-100 last:border-0 hover:bg-gray-50 group">
        <%= color_swatch(tag.color, css_class: "w-3 h-3") %>
        <%= link_to tag.name, tag, class: "flex-1 text-sm font-medium text-gray-800 hover:text-blue-600" %>
        <span class="text-xs text-gray-400"><%= tag.papers.count %> papers</span>
        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
          <%= link_to "Edit", edit_tag_path(tag),
              class: "px-2 py-1 text-xs text-gray-600 hover:bg-gray-200 rounded transition-colors" %>
          <%= button_to "Delete", tag, method: :delete,
              data: { turbo_confirm: "Delete tag #{tag.name}?" },
              class: "px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded transition-colors cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
