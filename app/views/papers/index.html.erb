<% content_for :full_bleed do %>
<div class="flex flex-col h-full overflow-hidden" data-controller="detail-panel">

  <%# List toolbar %>
  <div class="flex items-center gap-3 px-4 h-11 border-b border-gray-200 bg-white flex-shrink-0">
    <span class="font-medium text-gray-700">
      <% if params[:collection_id].present? %>
        <%= Collection.find_by(id: params[:collection_id])&.name || "Collection" %>
      <% elsif params[:tag_id].present? %>
        <%= Tag.find_by(id: params[:tag_id])&.name || "Tag" %>
      <% elsif params[:reading_status].present? %>
        <%= params[:reading_status].humanize %>
      <% elsif params[:sort] == "recent" %>
        Recently Added
      <% else %>
        All References
      <% end %>
    </span>
    <span class="text-xs text-gray-400">(<%= @papers.count %>)</span>
    <div class="flex-1"></div>
    <button class="flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700 px-2 py-1 rounded hover:bg-gray-100">
      <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5"></i>
      <span class="hidden sm:inline">Filters</span>
    </button>
  </div>

  <div class="flex flex-1 min-h-0">

    <%# Reference list %>
    <div class="flex-1 overflow-y-auto" id="ref-list">
      <% if @papers.empty? %>
        <div class="flex flex-col items-center justify-center h-64 text-gray-400 gap-3">
          <i data-lucide="inbox" class="w-12 h-12 opacity-30"></i>
          <p class="text-sm">No references found.</p>
          <%= link_to new_paper_path, class: "text-sm text-blue-600 hover:underline" do %>
            + Add your first paper
          <% end %>
        </div>
      <% else %>

        <%# Desktop table — hidden on mobile %>
        <table class="hidden md:table w-full text-sm border-collapse">
          <thead class="sticky top-0 bg-gray-50 z-10">
            <tr class="border-b border-gray-200">
              <th class="w-8 px-3 py-2"></th>
              <th class="w-8 px-1 py-2"></th>
              <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Authors</th>
              <th class="w-16 px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Year</th>
              <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Title</th>
              <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide hidden lg:table-cell">Source</th>
              <th class="w-8 px-3 py-2"></th>
            </tr>
          </thead>
          <tbody>
            <% @papers.each do |paper| %>
              <tr class="border-b border-gray-100 hover:bg-blue-50/50 cursor-pointer transition-colors group"
                  id="<%= dom_id(paper) %>"
                  data-detail-panel-target="row"
                  data-action="click->detail-panel#open"
                  data-paper-title="<%= paper.title %>"
                  data-paper-authors="<%= paper.authors %>"
                  data-paper-year="<%= paper.year %>"
                  data-paper-journal="<%= paper.journal %>"
                  data-paper-abstract="<%= truncate(paper.abstract, length: 300) %>"
                  data-paper-status="<%= paper.reading_status %>"
                  data-paper-url="<%= paper_path(paper) %>">
                <td class="px-3 py-2.5">
                  <input type="checkbox" class="rounded border-gray-300" onclick="event.stopPropagation()">
                </td>
                <td class="px-1 py-2.5 text-gray-300 group-hover:text-gray-400">
                  <i data-lucide="star" class="w-3.5 h-3.5"></i>
                </td>
                <td class="px-3 py-2.5 text-gray-600 max-w-[160px] truncate"><%= paper.authors %></td>
                <td class="px-3 py-2.5 text-gray-500"><%= paper.year %></td>
                <td class="px-3 py-2.5 max-w-xs">
                  <span class="font-medium text-gray-800 line-clamp-1"><%= paper.title %></span>
                  <div class="flex flex-wrap gap-1 mt-0.5">
                    <% paper.tags.each do |tag| %>
                      <%= tag_pill(tag) %>
                    <% end %>
                  </div>
                </td>
                <td class="px-3 py-2.5 text-gray-500 max-w-[140px] truncate hidden lg:table-cell"><%= paper.journal %></td>
                <td class="px-3 py-2.5">
                  <% if paper.pdf.attached? %>
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-blue-500" title="PDF"></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%# Mobile card list — visible only on mobile %>
        <ul class="md:hidden divide-y divide-gray-100">
          <% @papers.each do |paper| %>
            <li>
              <%= link_to paper, class: "flex flex-col gap-1 px-4 py-3 hover:bg-gray-50 active:bg-gray-100" do %>
                <div class="flex items-start justify-between gap-2">
                  <span class="font-medium text-gray-800 text-sm leading-snug line-clamp-2"><%= paper.title %></span>
                  <% if paper.pdf.attached? %>
                    <span class="mt-0.5 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                  <% end %>
                </div>
                <p class="text-xs text-gray-500 truncate">
                  <%= [paper.authors, paper.year, paper.journal].compact_blank.join(" · ") %>
                </p>
                <div class="flex flex-wrap gap-1 mt-0.5">
                  <%= status_badge(paper) %>
                  <% paper.tags.each do |tag| %>
                    <%= tag_pill(tag) %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>

      <% end %>
    </div>

    <%# Detail panel (desktop slide-in) %>
    <aside class="hidden md:flex flex-col w-80 xl:w-96 border-l border-gray-200 bg-white flex-shrink-0 transform translate-x-full transition-transform duration-200 absolute right-0 top-0 bottom-0 z-10 shadow-lg"
           data-detail-panel-target="panel">
      <div class="flex items-center border-b border-gray-200 px-3 h-10 flex-shrink-0">
        <div class="flex gap-1">
          <button class="px-3 py-1 text-xs font-medium text-blue-700 bg-blue-50 rounded-full">Info</button>
          <button class="px-3 py-1 text-xs font-medium text-gray-500 hover:bg-gray-100 rounded-full">Summary</button>
        </div>
        <div class="flex-1"></div>
        <button class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded"
                data-action="click->detail-panel#close" aria-label="Close">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto p-4" id="detail-panel-body">
        <p class="text-xs text-gray-400 text-center mt-8">Select a reference to see details.</p>
      </div>
    </aside>

  </div>
</div>
<% end %>
