<% content_for :title, @paper.title %>

<div class="max-w-4xl mx-auto">
  <%# Header %>
  <div class="flex items-start gap-3 mb-6">
    <%= link_to papers_path, class: "mt-1 p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg flex-shrink-0" do %>
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
    <% end %>
    <div class="flex-1 min-w-0">
      <h1 class="text-xl font-semibold text-gray-800 leading-snug"><%= @paper.title %></h1>
      <p class="mt-1 text-sm text-gray-500">
        <%= [@paper.authors, @paper.year, @paper.journal].compact_blank.join(" · ") %>
      </p>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= link_to "Edit", edit_paper_path(@paper),
          class: "px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= button_to "Delete", @paper, method: :delete,
          data: { turbo_confirm: "Delete this paper?" },
          class: "px-3 py-1.5 text-sm font-medium text-red-600 border border-red-200 rounded-lg hover:bg-red-50 transition-colors cursor-pointer" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

    <%# Main column %>
    <div class="lg:col-span-2 space-y-4">

      <%# Details card %>
      <div class="bg-white border border-gray-200 rounded-xl p-5">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Details</h2>
        <dl class="space-y-2 text-sm">
          <% if @paper.doi.present? %>
            <div class="flex gap-3">
              <dt class="w-20 text-gray-500 flex-shrink-0">DOI</dt>
              <dd><a href="https://doi.org/<%= @paper.doi %>" target="_blank" class="text-blue-600 hover:underline"><%= @paper.doi %></a></dd>
            </div>
          <% end %>
          <div class="flex gap-3">
            <dt class="w-20 text-gray-500 flex-shrink-0">Status</dt>
            <dd>
              <div class="flex flex-wrap gap-1" data-controller="reading-status" data-reading-status-url-value="<%= paper_path(@paper) %>">
                <% Paper.reading_statuses.each_key do |s| %>
                  <button class="status-btn <%= 'active' if @paper.reading_status == s %>"
                          data-reading-status-target="button"
                          data-status="<%= s %>"
                          data-action="click->reading-status#update">
                    <%= s.humanize %>
                  </button>
                <% end %>
              </div>
            </dd>
          </div>
          <% if @paper.rating.present? %>
            <div class="flex gap-3">
              <dt class="w-20 text-gray-500 flex-shrink-0">Rating</dt>
              <dd class="text-amber-400 tracking-wide"><%= ("★" * @paper.rating) + ("☆" * (5 - @paper.rating)) %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <% if @paper.abstract.present? %>
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Abstract</h2>
          <p class="text-sm text-gray-700 leading-relaxed"><%= @paper.abstract %></p>
        </div>
      <% end %>

      <% if @paper.notes.present? %>
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Notes</h2>
          <p class="text-sm text-gray-700 leading-relaxed"><%= @paper.notes %></p>
        </div>
      <% end %>

      <%# AI Summary %>
      <div class="bg-white border border-gray-200 rounded-xl p-5" id="summary-section">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">AI Summary</h2>
        <turbo-frame id="summary_paper_<%= @paper.id %>">
          <%= render "summary_frame", paper: @paper %>
        </turbo-frame>
      </div>

      <%# LaTeX %>
      <div class="bg-white border border-gray-200 rounded-xl p-5">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">LaTeX</h2>
        <%= link_to latex_preview_paper_path(@paper),
            class: "inline-flex items-center gap-1.5 text-sm text-gray-700 border border-gray-300 rounded-lg px-3 py-1.5 hover:bg-gray-50 transition-colors",
            target: "_blank" do %>
          <i data-lucide="eye" class="w-3.5 h-3.5"></i> Preview
        <% end %>
        <% if @paper.latex_documents.any? %>
          <ul class="mt-3 space-y-1">
            <% @paper.latex_documents.each do |doc| %>
              <li class="flex items-center gap-2 text-sm">
                <%= link_to doc.title, doc, class: "text-blue-600 hover:underline" %>
                <span class="text-gray-300">·</span>
                <%= link_to "Download .tex", download_latex_document_path(doc), class: "text-gray-500 hover:text-gray-700" %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    <%# Sidebar column %>
    <div class="space-y-4">

      <%# PDF card %>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">PDF</h2>
        <% if @paper.pdf.attached? %>
          <%= link_to pdf_viewer_paper_path(@paper),
              class: "inline-flex items-center gap-1.5 text-sm text-white bg-blue-600 rounded-lg px-3 py-1.5 hover:bg-blue-700 transition-colors" do %>
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Open PDF Reader
          <% end %>
          <% if @paper.extracted_text.present? %>
            <p class="mt-2 text-xs text-gray-400">Text extracted (<%= number_with_delimiter(@paper.extracted_text.length) %> chars)</p>
          <% else %>
            <p class="mt-2 text-xs text-gray-400">Extracting text…</p>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-400 mb-2">No PDF attached.</p>
          <%= link_to "Attach PDF", edit_paper_path(@paper),
              class: "text-sm text-blue-600 hover:underline" %>
        <% end %>
      </div>

      <%# Collections card %>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Collections</h2>
        <% if @paper.collections.any? %>
          <ul class="space-y-1">
            <% @paper.collections.each do |c| %>
              <li>
                <%= link_to c, class: "flex items-center gap-1.5 text-sm text-blue-600 hover:underline" do %>
                  <i data-lucide="folder" class="w-3.5 h-3.5"></i>
                  <%= c.name %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-400">Not in any collection.</p>
        <% end %>
      </div>

      <%# Tags card %>
      <div class="bg-white border border-gray-200 rounded-xl p-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Tags</h2>
        <div class="flex flex-wrap gap-1.5">
          <% if @paper.tags.any? %>
            <% @paper.tags.each do |tag| %>
              <%= tag_pill(tag) %>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-400">No tags.</p>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
