<div class="max-w-lg mx-auto">
  <h1 class="text-xl font-semibold text-gray-800 mb-6">Settings</h1>

  <% if notice %>
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg"><%= notice %></div>
  <% end %>

  <%= form_with url: settings_path, method: :patch, data: { controller: "settings-toggle" } do |f| %>

    <%# AI Provider selector %>
    <div class="bg-white border border-gray-200 rounded-xl p-5 mb-4">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-4">AI Provider</h2>
      <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer transition-colors
                      <%= @ai_provider == 'ollama' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300' %>">
          <%= radio_button_tag "settings[ai_provider]", "ollama", @ai_provider == "ollama",
              class: "text-blue-600", data: { action: "change->settings-toggle#toggle" } %>
          <div>
            <p class="text-sm font-medium text-gray-800">Ollama</p>
            <p class="text-xs text-gray-400">Local / self-hosted</p>
          </div>
        </label>
        <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer transition-colors
                      <%= @ai_provider == 'claude' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300' %>">
          <%= radio_button_tag "settings[ai_provider]", "claude", @ai_provider == "claude",
              class: "text-blue-600", data: { action: "change->settings-toggle#toggle" } %>
          <div>
            <p class="text-sm font-medium text-gray-800">Claude</p>
            <p class="text-xs text-gray-400">Anthropic API</p>
          </div>
        </label>
      </div>
    </div>

    <%# Ollama config %>
    <div class="bg-white border border-gray-200 rounded-xl p-5 mb-4 <%= @ai_provider == 'claude' ? 'opacity-50' : '' %>"
         data-settings-toggle-target="ollama">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-4">Ollama Configuration</h2>
      <div class="mb-4">
        <label for="settings_ollama_model" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Model</label>
        <%= text_field_tag "settings[ollama_model]", @ollama_model,
            id: "settings_ollama_model",
            list: "ollama-models-list",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <datalist id="ollama-models-list">
          <% @available_models.each do |m| %>
            <option value="<%= m %>"></option>
          <% end %>
        </datalist>
        <% if @available_models.any? %>
          <p class="mt-1 text-xs text-gray-400"><%= @available_models.count %> model(s) found: <%= @available_models.join(", ") %></p>
        <% else %>
          <p class="mt-1 text-xs text-gray-400">Could not reach Ollama — enter the model name manually.</p>
        <% end %>
      </div>
      <div>
        <label for="settings_ollama_endpoint" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Endpoint</label>
        <%= text_field_tag "settings[ollama_endpoint]", @ollama_endpoint,
            id: "settings_ollama_endpoint",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <p class="mt-1 text-xs text-gray-400">Default: http://localhost:11434/api/generate</p>
      </div>
    </div>

    <%# Claude config %>
    <div class="bg-white border border-gray-200 rounded-xl p-5 mb-4 <%= @ai_provider == 'ollama' ? 'opacity-50' : '' %>"
         data-settings-toggle-target="claude">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-4">Claude Configuration</h2>
      <div class="mb-4">
        <label for="settings_claude_api_key" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">API Key</label>
        <%= password_field_tag "settings[claude_api_key]", @claude_api_key.presence ? "••••••••" : "",
            id: "settings_claude_api_key",
            placeholder: "sk-ant-…",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono" %>
        <p class="mt-1 text-xs text-gray-400">
          Get your key at
          <a href="https://console.anthropic.com/settings/keys" target="_blank" class="text-blue-600 hover:underline">console.anthropic.com</a>
        </p>
      </div>
      <div>
        <label for="settings_claude_model" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Model</label>
        <%= select_tag "settings[claude_model]", options_for_select([
              ["Claude Sonnet 4.6 (Recommended)", "claude-sonnet-4-6"],
              ["Claude Opus 4.7",                 "claude-opus-4-7"],
              ["Claude Haiku 4.5",                "claude-haiku-4-5-20251001"]
            ], @claude_model),
            id: "settings_claude_model",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" %>
      </div>
    </div>

    <div class="pt-2">
      <%= submit_tag "Save Settings", class: "px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 cursor-pointer transition-colors" %>
    </div>
  <% end %>
</div>
